APP_NAME="Clínica San Luis"
APP_URL="http://localhost:3000"
APP_VERSION="2.0.0"
TIMEZONE="America/Asuncion"

# ─── Base de datos (TiDB Serverless / MySQL) ─────────────────
# Opción A: URL completa (recomendado para TiDB)
DATABASE_URL="mysql://user:pass@host:4000/clinica_san_luis?ssl-mode=REQUIRED"

# Opción B: Variables individuales (si no usás DATABASE_URL)
DB_HOST="gateway01.us-east-1.prod.aws.tidbcloud.com"
DB_PORT=4000
DB_USER="your_user"
DB_PASS="your_password"
DB_NAME="clinica_san_luis"

# ─── Auth (NextAuth v5) ───────────────────────────────────────
AUTH_SECRET="generate-a-random-32+chars-secret-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"

# ─── Mail (SMTP para confirmaciones y recordatorios) ──────────
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM_NAME="Clínica San Luis"
MAIL_RECORDATORIO_HORAS=24
